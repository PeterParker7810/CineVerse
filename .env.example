# Browser-safe Supabase project configuration (publishable/anon key only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only TMDB credentials. Never add a VITE_ prefix to these values.
TMDB_API_KEY=your-tmdb-v3-api-key
# Optional alternative to TMDB_API_KEY: a TMDB API Read Access Token.
TMDB_ACCESS_TOKEN=
